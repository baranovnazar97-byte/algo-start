# Скопируйте этот файл в .env и замените значения CHANGE_ME перед запуском.
COMPOSE_PROJECT_NAME=algorithmika

# Порт сайта на компьютере/сервере. На production безопаснее оставить 127.0.0.1
# и направить сюда HTTPS-трафик через Nginx хоста.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080
HTTPS_PORT=8443
# До покупки домена используется HTTP. После привязки setup-domain.cmd заменит значение.
SITE_ADDRESS=:80

POSTGRES_DB=algorithmika
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root

DB_HOST=localhost
DB_PORT=5432
DB_NAME=algorithmika
DB_USER=postgres
DB_PASSWORD=root

JWT_SECRET=5345caff-9a52-407b-b45d-95e9fb29e936
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:8080
# 2 для схемы: Nginx хоста -> frontend Nginx -> API. При прямом Docker-запуске можно поставить 1.
TRUST_PROXY_HOPS=2
DB_SSL=false
